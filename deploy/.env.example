# 复制为 deploy/.env 后使用。
# 服务器：docker compose pull && docker compose up -d（不编译）
# 本机构建：见 README「本地构建镜像」
#
# 目录约定（均在 /miyf 下）：
#   /miyf/app                 部署代码
#   /miyf/data/...            数据
#   /miyf/log/server|nginx    日志
#
# 当前公网：47.108.200.201
# 安全组：TCP 22、80；勿对公网开 5432/6379/9000/8080

MIYF_APP_ROOT=/miyf/app

MIYF_DATA_DB=/miyf/data/db/data
MIYF_DATA_REDIS=/miyf/data/redis/data
MIYF_DATA_OSS=/miyf/data/oss/resource
MIYF_DATA_ES=/miyf/data/elasticsearch
MIYF_DATA_NGINX_CERTS=/miyf/data/nginx/certs

MIYF_LOG_SERVER=/miyf/log/server
MIYF_LOG_NGINX=/miyf/log/nginx
LOG_PATH=/miyf/log/server

# 运行时镜像（全部走 ACR，服务器不访问 docker.io）
MIYF_IMAGE_SERVER=registry.cn-shanghai.aliyuncs.com/miyf/miyf_app:0.1.0
MIYF_IMAGE_NGINX=registry.cn-shanghai.aliyuncs.com/miyf/miyf_nginx:0.1.0
MIYF_IMAGE_POSTGRES=registry.cn-shanghai.aliyuncs.com/miyf/postgres:16-alpine
MIYF_IMAGE_REDIS=registry.cn-shanghai.aliyuncs.com/miyf/redis:7-alpine
MIYF_IMAGE_MINIO=registry.cn-shanghai.aliyuncs.com/miyf/minio:latest
# 若服务器不能拉 docker.elastic.co，请先同步到 ACR 后改此项
# MIYF_IMAGE_ES=registry.cn-shanghai.aliyuncs.com/miyf/elasticsearch:8.17.0

# 本机构建用基础镜像（ACR）
BASE_MAVEN_IMAGE=registry.cn-shanghai.aliyuncs.com/miyf/maven:3.9.9-eclipse-temurin-21
BASE_JRE_IMAGE=registry.cn-shanghai.aliyuncs.com/miyf/eclipse-temurin:21-jre-alpine
BASE_NODE_IMAGE=registry.cn-shanghai.aliyuncs.com/miyf/node:20-alpine
BASE_NGINX_IMAGE=registry.cn-shanghai.aliyuncs.com/miyf/nginx:1.27-alpine

POSTGRES_DB=miyf
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

REDIS_PASSWORD=
# Lettuce 连接池（spring.data.redis.lettuce.pool）
# REDIS_LETTUCE_MAX_ACTIVE=16
# REDIS_LETTUCE_MAX_IDLE=8
# REDIS_LETTUCE_MIN_IDLE=2
# REDIS_LETTUCE_MAX_WAIT=3s
# APP_REDIS_ENABLED=true
# REDIS_CACHE_TREE_TTL=600
# REDIS_CACHE_OBJECT_TTL=300

JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_EXPIRE_SECONDS=604800
WX_AUTH_MOCK_ENABLED=true
WX_APP_ID=
WX_APP_SECRET=
SPRING_PROFILES_ACTIVE=docker

# 华为运动健康（Health Kit）OAuth；默认关闭。开启后管理端 /health/providers 可授权同步。
# redirect-uri 须与华为开放平台「授权回调 URL」完全一致，且指向管理端该页。
APP_HEALTH_PROVIDER_HUAWEI_ENABLED=false
APP_HEALTH_HUAWEI_MOCK=true
HUAWEI_HEALTH_CLIENT_ID=
HUAWEI_HEALTH_CLIENT_SECRET=
HUAWEI_HEALTH_REDIRECT_URI=http://localhost:5173/health/providers
# APP_HEALTH_SYNC_CRON=0 15 * * * *

# Elasticsearch 搜索（默认关闭；开启前先起 compose elasticsearch 服务）
APP_SEARCH_ENABLED=false
APP_SEARCH_INDEX_PREFIX=miyf
ELASTICSEARCH_URIS=http://elasticsearch:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=

FILE_STORAGE_TYPE=minio
FILE_STORAGE_BUCKET=miyf
FILE_STORAGE_ACCESS_KEY=minioadmin
FILE_STORAGE_SECRET_KEY=minioadmin
FILE_STORAGE_BASE_URL=http://www.miyf.cn/media
FILE_STORAGE_AUTO_CREATE_BUCKET=true
FILE_STORAGE_PUBLIC_READ=true

NGINX_HTTP_PORT=80
