DATABASE_TYPE=postgresql
PRIMARY_DB_URL=jdbc:postgresql://localhost:5432/miyf
PRIMARY_DB_USERNAME=postgres
PRIMARY_DB_PASSWORD=change-me
SECONDARY_DB_ENABLED=false
SECONDARY_DB_TYPE=mysql
SECONDARY_DB_URL=
SECONDARY_DB_USERNAME=
SECONDARY_DB_PASSWORD=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
APP_REDIS_ENABLED=true
REDIS_RATE_LIMIT_ENABLED=true
REDIS_LOGIN_MAX_ATTEMPTS=10
REDIS_LOGIN_WINDOW_SECONDS=300
REDIS_API_MAX_REQUESTS=120
REDIS_API_WINDOW_SECONDS=60
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_EXPIRE_SECONDS=604800
WX_APP_ID=your-app-id
WX_APP_SECRET=your-app-secret
WX_AUTH_MOCK_ENABLED=true
DRUID_STAT_USERNAME=change-me
DRUID_STAT_PASSWORD=change-me
FILE_STORAGE_TYPE=minio
FILE_STORAGE_PATH=./uploads
# 公开访问前缀（不含 /r）；实际 URL 为 {BASE}/r/{fileId}
# 本地直连后端用 http://localhost:8080；Docker + Nginx 用 http://localhost 或公网域名
FILE_STORAGE_BASE_URL=http://localhost:8080
# 存储分区命名空间：{namespace}/{appCode}/yyyy/MM/{fileId}
FILE_STORAGE_PATH_NAMESPACE=miyf
FILE_STORAGE_MAX_SIZE_BYTES=5242880
FILE_STORAGE_ENDPOINT=http://localhost:9000
FILE_STORAGE_BUCKET=miyf
FILE_STORAGE_ACCESS_KEY=minioadmin
FILE_STORAGE_SECRET_KEY=minioadmin
FILE_STORAGE_REGION=
FILE_STORAGE_AUTO_CREATE_BUCKET=true
FILE_STORAGE_PUBLIC_READ=true
# 文件签名 URL 专用 HMAC 密钥（与 JWT_SECRET 分离，至少 32 位）
# 签名有效期见管理端系统配置 file.access.sign.ttl.seconds（默认 18000 秒）
FILE_STORAGE_ACCESS_SIGN_SECRET=change-me-file-access-sign-secret-32chars
NGINX_HTTP_PORT=80
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev
ADMIN_SEED_USERNAME=admin
ADMIN_SEED_PASSWORD=change-me
POSTGRES_DB=miyf
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
