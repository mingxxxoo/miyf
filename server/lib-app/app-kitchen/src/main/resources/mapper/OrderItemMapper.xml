<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!-- 预约明细 SQL @author XieMingJie @since 2026-09-04 16:41 -->
<mapper namespace="cn.miyf.kitchen.repository.mapper.OrderItemMapper">

    <select id="selectByOrderId"
            resultType="cn.miyf.kitchen.bean.entity.OrderItemEntity">
        SELECT id, order_id, dish_id, dish_name, quantity, unit, remark, created_at
        FROM kitchen_order_item
        WHERE order_id = #{orderId}
        ORDER BY created_at ASC
    </select>
</mapper>
