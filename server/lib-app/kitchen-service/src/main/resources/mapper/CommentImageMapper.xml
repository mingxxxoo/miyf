<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!-- 评论图片 SQL @author XieMingJie @since 2026-09-04 16:41 -->
<mapper namespace="cn.miyf.kitchen.repository.mapper.CommentImageMapper">

    <select id="selectByCommentId"
            resultType="cn.miyf.kitchen.bean.entity.CommentImageEntity">
        SELECT id, comment_id, image_url AS url, sort_order, create_time, last_modify_time
        FROM kitchen_comment_image
        WHERE comment_id = #{commentId}
        ORDER BY sort_order ASC
    </select>

    <delete id="deleteByCommentId">
        DELETE FROM kitchen_comment_image
        WHERE comment_id = #{commentId}
    </delete>
</mapper>
