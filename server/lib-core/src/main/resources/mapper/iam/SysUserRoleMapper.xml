<!-- IAM 用户角色绑定 SQL @author XieMingJie @since 2026-09-05 -->
<mapper namespace="cn.miyf.repository.mapper.SysUserRoleMapper">

    <delete id="deleteByUserId">
        DELETE FROM sys_user_role
        WHERE user_id = #{userId}
    </delete>
</mapper>
