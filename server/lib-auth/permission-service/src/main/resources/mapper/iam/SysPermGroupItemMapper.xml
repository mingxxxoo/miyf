<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!-- IAM 权限组条目 SQL @author XieMingJie @since 2026-09-05 -->
<mapper namespace="cn.miyf.repository.mapper.SysPermGroupItemMapper">

    <select id="selectByGroupAndPermission" resultType="cn.miyf.bean.entity.SysPermGroupItemEntity">
        SELECT id, group_id, permission_id, create_time
        FROM sys_perm_group_item
        WHERE group_id = #{groupId}
          AND permission_id = #{permissionId}
        LIMIT 1
    </select>

    <delete id="deleteByGroupId">
        DELETE FROM sys_perm_group_item
        WHERE group_id = #{groupId}
    </delete>

    <delete id="deleteByPermissionId">
        DELETE FROM sys_perm_group_item
        WHERE permission_id = #{permissionId}
    </delete>

    <select id="selectPermissionIdsByGroupId" resultType="java.lang.Long">
        SELECT permission_id
        FROM sys_perm_group_item
        WHERE group_id = #{groupId}
        ORDER BY permission_id
    </select>

    <select id="selectByGroupIds" resultType="cn.miyf.bean.entity.SysPermGroupItemEntity">
        SELECT id, group_id, permission_id, create_time
        FROM sys_perm_group_item
        WHERE group_id IN
        <foreach collection="groupIds" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </select>
</mapper>
